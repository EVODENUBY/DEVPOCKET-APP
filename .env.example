# Use the computer's LAN IP when testing Expo Go on a physical Android device.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Backend
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*
DATABASE_URL=postgresql://devpocket:devpocket@localhost:5433/devpocket?schema=public
# Generate a unique local value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# OAuth sign-in (optional). Register callback URLs as:
# <OAUTH_CALLBACK_BASE_URL>/api/v1/auth/oauth/github/callback
# <OAUTH_CALLBACK_BASE_URL>/api/v1/auth/oauth/google/callback
# OAUTH_CALLBACK_BASE_URL=http://localhost:3000
# OAUTH_MOBILE_REDIRECT_PREFIXES=devpocket://,exp://
# Generate like JWT_ACCESS_SECRET; required to persist provider tokens at rest.
# OAUTH_TOKEN_KEY=
# GitHub OAuth app: https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Google OAuth client: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
